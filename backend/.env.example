PORT=8080
BACKEND_PUBLIC_URL=https://api.example.com
JWT_SECRET=change-me-at-least-32-chars
# Existing Supabase project (auth + Postgres). Backend verifies user JWT via Supabase Auth.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Meta AI (server-side only)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
MODEL_SPARK=muse-spark-1.3
MODEL_IMAGE=muse-image-1.0
MODEL_SAM=sam-3.1
# RustFS S3-compatible media storage
RUSTFS_ENDPOINT=https://rustfs.example.com
RUSTFS_PUBLIC_URL=https://rustfs.example.com/recygo-media
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=recygo-media
CORS_ORIGINS=*
